    // 6. UTILITÁRIOS MATEMÁTICOS, GEOMÉTRICOS E EASING
    function degToRad(deg) {
      return (deg * Math.PI) / 180;
    }

    function polarToCartesian(cx, cy, r, angleDeg) {
      const rad = degToRad(angleDeg);
      return {
        x: cx + r * Math.cos(rad),
        y: cy + r * Math.sin(rad)
      };
    }

    function describeArc(cx, cy, r, startAngle, endAngle, sweepFlag = 1) {
      const sweep = endAngle - startAngle;
      if (Math.abs(sweep) >= 359.9) {
        const start = polarToCartesian(cx, cy, r, startAngle);
        const end = polarToCartesian(cx, cy, r, startAngle + 359.9);
        return `M ${start.x.toFixed(2)} ${start.y.toFixed(2)} A ${r} ${r} 0 1 1 ${end.x.toFixed(2)} ${end.y.toFixed(2)}`;
      }
      const start = polarToCartesian(cx, cy, r, startAngle);
      const end = polarToCartesian(cx, cy, r, endAngle);
      const largeArcFlag = Math.abs(sweep) > 180 ? '1' : '0';
      return `M ${start.x.toFixed(2)} ${start.y.toFixed(2)} A ${r} ${r} 0 ${largeArcFlag} ${sweepFlag} ${end.x.toFixed(2)} ${end.y.toFixed(2)}`;
    }

    // Calcula os ângulos alvo de cada fatia no Anel Geral (360° iguais) ou na Seção em Foco (180° ativo + 180° restantes)
    function getTargetSectionAngles(secIdx, mode, targetActiveSecId) {
      const N = appData.sections.length;
      if (N === 0) return { start: -90, end: 270 };

      const stepDeg = 360 / N;
      const gapDeg = N === 1 ? 0 : Math.min(5, stepDeg * 0.12);
      const macroStart = -90 + secIdx * stepDeg + gapDeg / 2;
      const macroEnd = -90 + (secIdx + 1) * stepDeg - gapDeg / 2;

      if (mode !== 'micro' || !targetActiveSecId) {
        return { start: macroStart, end: macroEnd };
      }

      const activeIdx = appData.sections.findIndex(s => s.id === targetActiveSecId);
      if (activeIdx === -1) {
        return { start: macroStart, end: macroEnd };
      }

      const activeMacroStart = -90 + activeIdx * stepDeg + gapDeg / 2;
      const activeMacroEnd = -90 + (activeIdx + 1) * stepDeg - gapDeg / 2;
      const activeMacroMid = (activeMacroStart + activeMacroEnd) / 2;

      if (N === 1) {
        return {
          start: activeMacroMid - 90,
          end: activeMacroMid + 90
        };
      }

      if (secIdx === activeIdx) {
        const activeGap = 4;
        return {
          start: activeMacroMid - 90 + activeGap / 2,
          end: activeMacroMid + 90 - activeGap / 2
        };
      }

      // Distribui as demais (N - 1) seções uniformemente no semicírculo oposto (180°)
      const offsetFromActive = (secIdx - activeIdx + N) % N; // 1 .. N-1
      const otherStep = 180 / (N - 1);
      const otherGap = Math.min(3.5, otherStep * 0.14);
      const start = activeMacroMid + 90 + (offsetFromActive - 1) * otherStep + otherGap / 2;
      const end = activeMacroMid + 90 + offsetFromActive * otherStep - otherGap / 2;

      return { start, end };
    }

    function polygonPoints(cx, cy, r, sides = 6, rotationDeg = -90) {
      const pts = [];
      for (let i = 0; i < sides; i++) {
        const angle = rotationDeg + (i * 360) / sides;
        const p = polarToCartesian(cx, cy, r, angle);
        pts.push(`${p.x.toFixed(1)},${p.y.toFixed(1)}`);
      }
      return pts.join(' ');
    }

    function shortestAngleDelta(fromDeg, toDeg) {
      const diff = (((toDeg - fromDeg + 180) % 360) + 360) % 360 - 180;
      return diff === -180 ? 180 : diff;
    }

    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function clamp01(v) {
      return v < 0 ? 0 : v > 1 ? 1 : v;
    }

    function lerp(a, b, t) {
      return a + (b - a) * t;
    }

    // Calcula enquadramento ideal para a Visão Micro adaptado ao viewport e à extensão da árvore
    function getCanonicalMicroFraming(sectionId) {
      const secMeta = sceneRegistry.sections.get(sectionId);
      const midAngle = secMeta ? secMeta.midAngle : -90;
      const targetRot = camera.rotDeg + shortestAngleDelta(camera.rotDeg, -90 - midAngle);

      const svg = document.getElementById('skill-svg');
      const rect = svg.getBoundingClientRect();
      const aspect = rect.width > 0 && rect.height > 0 ? rect.width / rect.height : 1;

      // Calcula extensão máxima dos nós da seção em coordenadas rotacionadas (topo em -90°)
      let maxTopExtent = 390;
      let maxHalfWidth = 310;
      const secNodes = appData.nodes.filter(n => n.sectionId === sectionId);
      secNodes.forEach((n) => {
        const entry = sceneRegistry.nodes.get(n.id);
        if (entry && entry.microPos) {
          const rotRad = degToRad(-90 - midAngle);
          const rx = entry.microPos.x * Math.cos(rotRad) - entry.microPos.y * Math.sin(rotRad);
          const ry = entry.microPos.x * Math.sin(rotRad) + entry.microPos.y * Math.cos(rotRad);
          maxHalfWidth = Math.max(maxHalfWidth, Math.abs(rx) + 56);
          maxTopExtent = Math.max(maxTopExtent, Math.abs(ry) + 52);
        }
      });

      if (aspect < 0.85) {
        // Modo retrato (Android): garante margem lateral e vertical confortável
        const zoomByWidth = 475 / Math.max(320, maxHalfWidth);
        const targetZoom = Math.min(1.42, Math.max(1.05, zoomByWidth));
        const targetPanY = Math.min(500, Math.max(410, maxTopExtent * targetZoom - 115));
        return { zoom: targetZoom, panX: 0, panY: targetPanY, rotDeg: targetRot };
      } else {
        // Modo paisagem / desktop
        const zoomByHeight = 680 / Math.max(420, maxTopExtent + 160);
        const targetZoom = Math.min(1.55, Math.max(1.15, zoomByHeight));
        const targetPanY = Math.min(460, Math.max(370, maxTopExtent * targetZoom - 210));
        return { zoom: targetZoom, panX: 0, panY: targetPanY, rotDeg: targetRot };
      }
    }

    function getSkillStats(nodesSubset) {
      const skills = nodesSubset.filter(n => n.nodeType === 'skill');
      const completed = skills.filter(n => n.status === 'completed');
      const xp = completed.reduce((acc, n) => acc + (DIFFICULTY_TIERS[n.difficulty]?.xp || 50), 0);
      return {
        totalSkills: skills.length,
        completedSkills: completed.length,
        xp
      };
    }

    function getDescendantNodes(rootId) {
      const result = [];
      const queue = [rootId];
      while (queue.length > 0) {
        const currId = queue.shift();
        const children = appData.nodes.filter(n => n.parentId === currId);
        children.forEach(c => {
          result.push(c);
          queue.push(c.id);
        });
      }
      return result;
    }

    function computeSubtreeWeight(nodeId, sectionNodes) {
      const children = sectionNodes.filter(n => n.parentId === nodeId);
      if (children.length === 0) return 1;
      let sum = 0;
      children.forEach(c => {
        sum += computeSubtreeWeight(c.id, sectionNodes);
      });
      return Math.max(1, sum);
    }

    function computeMaxSubtreeDepth(nodeId, sectionNodes) {
      const children = sectionNodes.filter(n => n.parentId === nodeId);
      if (children.length === 0) return 1;
      let maxChildDepth = 0;
      children.forEach(c => {
        maxChildDepth = Math.max(maxChildDepth, computeMaxSubtreeDepth(c.id, sectionNodes));
      });
      return 1 + maxChildDepth;
    }

    // 7. CONSTRUÇÃO DO GRAFO DE CENA SVG UNIFICADO (PERSISTENTE)
    function rebuildSceneDOM() {
      const treesLayer = document.getElementById('layer-section-trees');
