<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#05080d" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="application-name" content="ctOS Skills" />
  <title>ctOS // Skill Tree Pessoal</title>

  <!-- Favicon SVG embutido -->
  <link id="app-favicon" rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%2305080d'/%3E%3Ccircle cx='50' cy='50' r='33' fill='none' stroke='%2300e5ff' stroke-width='8' stroke-dasharray='46 9'/%3E%3Cpolygon points='50,33 65,41.5 65,58.5 50,67 35,58.5 35,41.5' fill='none' stroke='%23ffffff' stroke-width='4'/%3E%3Ccircle cx='50' cy='50' r='5' fill='%2300e5ff'/%3E%3C/svg%3E" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Fontes HUD / Watch Dogs 1 (Rajdhani + Share Tech Mono + Inter) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Rajdhani:wght@500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            hud: ['Rajdhani', 'sans-serif'],
            mono: ['Share Tech Mono', 'monospace'],
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    };
  </script>

  <style>
    /* Reset e comportamento nativo mobile */
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    input, textarea, select {
      user-select: text;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #05080d;
      color: #f8fafc;
      font-family: 'Inter', sans-serif;
      touch-action: none;
    }

    button, label, input, select, textarea {
      touch-action: manipulation;
    }

    /* Fundo tático escuro estilo mapa ctOS com vinheta radial */
    .ctos-tactical-bg {
      background-color: #05080d;
      background-image:
        radial-gradient(circle at 50% 48%, rgba(0, 229, 255, 0.045) 0%, rgba(5, 8, 13, 0.96) 72%),
        linear-gradient(to right, rgba(255, 255, 255, 0.024) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.024) 1px, transparent 1px);
      background-size: 100% 100%, 40px 40px, 40px 40px;
    }

    /* Scanlines sutis de monitor HUD */
    .ctos-scanlines {
      background: repeating-linear-gradient(
        to bottom,
        transparent 0px,
        transparent 3px,
        rgba(0, 0, 0, 0.22) 4px
      );
      pointer-events: none;
    }

    @keyframes pulseReticle {
      0%, 100% { transform: scale(1); opacity: 0.95; }
      50% { transform: scale(1.13); opacity: 0.5; }
    }

    .node-selection-reticle {
      transform-box: fill-box;
      transform-origin: center;
      animation: pulseReticle 1.9s infinite ease-in-out;
    }

    .svg-node-group {
      cursor: pointer;
    }

    .svg-arc-segment {
      cursor: pointer;
      transition: filter 0.22s ease;
    }

    .svg-arc-segment:hover {
      filter: brightness(1.22);
    }

    /* Transições suaves para painéis HUD */
    .hud-slide-top {
      transition: opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1), transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .hud-slide-bottom {
      transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
    }

    /* Scrollbar discreta nos modais */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #090d16;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="ctos-tactical-bg relative w-full h-full flex flex-col justify-between">

  <!-- Scanlines HUD -->
  <div class="ctos-scanlines fixed inset-0 z-10"></div>

  <!-- ===================================================================== -->
  <!-- TOP HUD BAR (Navegação Superior Responsiva 360px+)                    -->
  <!-- ===================================================================== -->
  <header id="top-hud" class="relative z-30 w-full px-2 sm:px-3 pt-2.5 pb-2 flex items-center justify-between gap-1.5 sm:gap-2 pointer-events-none">

    <!-- Esquerda: Marca ctOS (Macro) ou Botão Voltar ao Anel (Micro) -->
    <div class="flex items-center shrink-0 pointer-events-auto">
      <div id="macro-brand" class="flex items-center gap-1.5 sm:gap-2 bg-[#090d16]/90 border border-slate-800/90 backdrop-blur-md px-2.5 sm:px-3 py-2 rounded-xl shadow-lg whitespace-nowrap">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shrink-0"></span>
        <span class="font-hud font-bold tracking-widest text-xs sm:text-base text-white uppercase">ctOS <span class="text-slate-400 font-medium">// SKILLS</span></span>
      </div>

      <button id="btn-back-macro" onclick="switchToMacro()" class="hidden items-center gap-1 bg-[#090d16]/90 hover:bg-slate-800 active:scale-95 border border-slate-700/90 backdrop-blur-md px-2.5 sm:px-3 py-2 rounded-xl text-xs sm:text-sm font-hud font-semibold tracking-wider text-slate-200 uppercase transition shadow-lg whitespace-nowrap">
        <svg class="w-4 h-4 text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M15 18l-6-6 6-6"/></svg>
        <span>Anel</span>
        <span class="hidden sm:inline">Geral</span>
      </button>
    </div>

    <!-- Centro: Carrossel de Seções na Visão Micro (< Anterior | Seção | Próxima >) -->
    <div id="micro-nav" class="hud-slide-top opacity-0 -translate-y-3 pointer-events-none hidden items-center justify-between gap-0.5 sm:gap-2 flex-1 min-w-0 max-w-[250px] sm:max-w-sm mx-auto bg-[#090d16]/95 border border-slate-800/90 backdrop-blur-md px-1.5 sm:px-2.5 py-1.5 rounded-xl shadow-xl">
      <button type="button" onclick="navigateSection(-1)" title="Seção Anterior" class="p-1.5 sm:p-2 rounded-lg hover:bg-slate-800 active:scale-90 text-slate-300 transition flex items-center gap-1 shrink-0 cursor-pointer">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 18l-6-6 6-6"/></svg>
        <span id="prev-sec-label" class="hidden md:inline text-xs font-hud uppercase tracking-wider text-slate-400">Anterior</span>
      </button>

      <div class="flex flex-col items-center flex-1 min-w-0 px-0.5">
        <!-- Dots indicadores das seções -->
        <div id="section-dots" class="flex items-center gap-1.5 mb-0.5"></div>
        <div class="flex items-center justify-center gap-1 w-full min-w-0">
          <span id="micro-sec-title" class="font-hud font-bold text-sm sm:text-lg tracking-wider text-white uppercase leading-none truncate">Música</span>
          <button type="button" onclick="openSectionModal(true)" title="Editar Seção" class="text-slate-400 hover:text-white hover:bg-slate-800 active:scale-90 p-1.5 -m-0.5 rounded-lg transition shrink-0 cursor-pointer">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </button>
        </div>
        <span id="micro-sec-progress" class="text-[9px] sm:text-[10px] font-mono text-slate-400 tracking-wider mt-0.5 truncate max-w-full">0/0 HABILIDADES</span>
      </div>

      <button type="button" onclick="navigateSection(1)" title="Próxima Seção" class="p-1.5 sm:p-2 rounded-lg hover:bg-slate-800 active:scale-90 text-slate-300 transition flex items-center gap-1 shrink-0 cursor-pointer">
        <span id="next-sec-label" class="hidden md:inline text-xs font-hud uppercase tracking-wider text-slate-400">Próxima</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <!-- Direita: Molde & Dados Locais -->
    <div class="flex items-center shrink-0 pointer-events-auto">
      <button onclick="openDataModal()" title="Molde & Backup" class="bg-[#090d16]/90 hover:bg-slate-800 active:scale-95 border border-slate-800 backdrop-blur-md p-2 sm:px-3 sm:py-2 rounded-xl text-xs font-hud font-semibold tracking-wider text-slate-300 uppercase flex items-center gap-1.5 transition shadow-lg whitespace-nowrap">
        <svg class="w-4 h-4 text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
        <span class="hidden sm:inline">Molde / Dados</span>
      </button>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- ÁREA INTERATIVA PRINCIPAL (SVG Unificado com Camera Rig 60fps)        -->
  <!-- ===================================================================== -->
  <main id="canvas-container" class="relative flex-1 w-full h-full overflow-hidden z-20">
    <svg id="skill-svg" class="w-full h-full block" viewBox="-500 -500 1000 1000" preserveAspectRatio="xMidYMid meet">
      <defs>
        <!-- Brilho neon padrão -->
        <filter id="neon-glow" x="-45%" y="-45%" width="190%" height="190%">
          <feGaussianBlur stdDeviation="4.5" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <!-- Brilho neon intenso para arcos em foco -->
        <filter id="strong-glow" x="-65%" y="-65%" width="230%" height="230%">
          <feGaussianBlur stdDeviation="8" result="blur1" />
          <feGaussianBlur stdDeviation="3" result="blur2" />
          <feMerge>
            <feMergeNode in="blur1" />
            <feMergeNode in="blur2" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <!-- Caminhos circulares dinâmicos para textos curvos das seções -->
        <g id="dynamic-text-paths"></g>
      </defs>

      <!-- Rig de Câmera Unificado: translate(panX, panY) scale(zoom) rotate(rotDeg) -->
      <g id="camera-rig">
        <!-- Luz ambiental radial dinâmica -->
        <circle id="ambient-glow" cx="0" cy="0" r="275" fill="#00e5ff" opacity="0.06" pointer-events="none"></circle>

        <!-- Camada 1: Árvores de ramos e habilidades por seção (atrás do anel) -->
        <g id="layer-section-trees"></g>

        <!-- Camada 2: Anel central, fatias coloridas, textos curvos e emblema central -->
        <g id="layer-central-ring"></g>

        <!-- Camada 3: Cabeçalho interno do arco ativo na Visão Micro (upright) -->
        <g id="layer-active-arc-hud" pointer-events="none"></g>
      </g>
    </svg>

    <!-- Estado Vazio (Molde em Branco) -->
    <div id="empty-mold-overlay" class="hidden absolute inset-0 flex flex-col items-center justify-center p-6 text-center pointer-events-none z-20">
      <div class="bg-[#090d16]/95 border border-slate-800 backdrop-blur-md p-6 rounded-2xl max-w-sm pointer-events-auto shadow-2xl">
        <div class="w-12 h-12 rounded-full border-2 border-dashed border-cyan-400/60 flex items-center justify-center mx-auto mb-3 text-cyan-400">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <h2 class="font-hud font-bold text-xl tracking-wider uppercase text-white mb-1">Molde em Branco</h2>
        <p class="text-xs text-slate-400 mb-4 leading-relaxed">Seu anel de habilidades está limpo. Crie sua primeira seção (ex: Música, Programação, Saúde, Projetos) para começar.</p>
        <button onclick="openSectionModal(false)" class="w-full py-2.5 px-4 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-hud font-bold tracking-wider uppercase text-sm transition shadow-lg">
          + Criar Primeira Seção
        </button>
      </div>
    </div>

    <!-- Dica quando a seção está vazia na Visão Micro -->
    <div id="empty-section-hint" class="hidden absolute inset-x-0 top-1/3 flex justify-center px-4 pointer-events-none z-20">
      <div class="bg-[#090d16]/90 border border-slate-800 backdrop-blur-md px-5 py-4 rounded-2xl max-w-xs text-center pointer-events-auto shadow-xl">
        <p class="font-hud font-bold text-base uppercase tracking-wider text-white mb-1">Seção Vazia</p>
        <p class="text-xs text-slate-400 mb-3 leading-relaxed">Adicione um <span class="text-cyan-300 font-semibold">Ramo / Subcategoria</span> (ex: Guitarra, Flauta) ou uma <span class="text-white font-semibold">Habilidade</span> inicial neste arco.</p>
        <button onclick="openNodeModal('create_root')" class="w-full py-2 px-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-hud font-bold text-xs uppercase tracking-wider transition">
          + Novo Ramo no Arco
        </button>
      </div>
    </div>

    <!-- Controles Flutuantes de Câmera (Zoom + / - / Centralizar Câmera) -->
    <div class="absolute right-2.5 sm:right-3 top-2 flex flex-col items-end gap-1.5 z-30">
      <div class="flex flex-col gap-1.5">
        <button onclick="zoomBy(1.22)" title="Aproximar" class="w-9 h-9 rounded-xl bg-[#090d16]/85 hover:bg-slate-800 active:scale-90 border border-slate-800 text-slate-200 flex items-center justify-center shadow-md backdrop-blur-sm font-bold text-lg">+</button>
        <button onclick="zoomBy(0.82)" title="Afastar" class="w-9 h-9 rounded-xl bg-[#090d16]/85 hover:bg-slate-800 active:scale-90 border border-slate-800 text-slate-200 flex items-center justify-center shadow-md backdrop-blur-sm font-bold text-lg">−</button>
      </div>

      <button id="btn-recenter-cam" onclick="recenterCurrentView()" title="Centralizar Câmera" class="h-9 px-2.5 rounded-xl bg-[#090d16]/85 hover:bg-slate-800 active:scale-90 border border-slate-800 text-slate-300 flex items-center justify-center gap-1.5 shadow-md backdrop-blur-sm transition">
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M3 12h3m12 0h3M12 3v3m0 12v3"/></svg>
        <span id="recenter-label" class="hidden text-[11px] font-hud font-bold uppercase tracking-wider text-cyan-300">Centralizar</span>
      </button>
    </div>

    <!-- Barra Inferior Unificada (Ação Principal + XP Acumulado + Legenda sem sobreposição) -->
    <div id="bottom-hud-bar" class="absolute inset-x-0 bottom-0 z-30 px-2.5 sm:px-3 pb-2.5 pt-1 flex flex-col gap-1.5 pointer-events-none transition-opacity duration-200">
      <!-- Linha 1: Botão de Criação (+ Seção / + Novo Ramo) à esquerda & Pill XP à direita -->
      <div class="flex items-center justify-between gap-2 w-full">
        <div class="flex items-center pointer-events-auto">
          <button id="btn-add-section" onclick="openSectionModal(false)" class="bg-[#090d16]/95 hover:bg-cyan-500/20 active:scale-95 border border-cyan-400/70 backdrop-blur-md px-3 py-1.5 rounded-xl text-xs sm:text-sm font-hud font-bold tracking-wider text-cyan-300 uppercase flex items-center gap-1 transition shadow-lg whitespace-nowrap">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Nova Seção</span>
          </button>

          <button id="btn-add-root-bottom" onclick="openNodeModal('create_root')" class="hidden bg-[#090d16]/95 hover:bg-cyan-500/20 active:scale-95 border border-cyan-400/70 backdrop-blur-md px-3 py-1.5 rounded-xl text-xs sm:text-sm font-hud font-bold tracking-wider text-cyan-300 uppercase items-center gap-1 transition shadow-lg whitespace-nowrap">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Novo Ramo</span>
          </button>
        </div>

        <!-- Contador Persistente de XP Acumulado (Estilo Watch Dogs) -->
        <div id="xp-hud-badge" class="bg-white text-[#05080d] px-2.5 sm:px-3 py-1.5 rounded-lg shadow-xl flex items-center gap-1.5 sm:gap-2 border border-white/80 shrink-0 pointer-events-auto">
          <span class="font-hud font-bold text-[11px] sm:text-sm tracking-widest uppercase">XP ACUMULADO</span>
          <svg class="w-3.5 h-3.5 text-cyan-600 shrink-0" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span id="total-xp-value" class="font-hud font-bold text-xs sm:text-base leading-none">0</span>
        </div>
      </div>

      <!-- Linha 2: Legenda Visual Discreta (Ramo vs Habilidade) -->
      <div id="legend-badge" class="self-start bg-[#090d16]/85 border border-slate-800/90 backdrop-blur-md px-2.5 py-1 rounded-lg flex items-center gap-3 text-[10px] font-hud uppercase tracking-wider text-slate-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-3 h-3 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polygon points="12 2 21 7 21 17 12 22 3 17 3 7"/></svg>
          <span>Ramo</span>
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="8"/></svg>
          <span>Habilidade</span>
        </span>
      </div>
    </div>
  </main>

  <!-- ===================================================================== -->
  <!-- PAINEL INFERIOR DO NÓ SELECIONADO (Estilo HUD Watch Dogs 1)           -->
  <!-- ===================================================================== -->
  <section id="node-hud-drawer" class="hud-slide-bottom translate-y-full opacity-0 pointer-events-none fixed inset-x-0 bottom-0 z-40 bg-[#080c14]/95 border-t border-slate-800 backdrop-blur-xl px-4 pt-3.5 pb-5 sm:px-6 shadow-[0_-15px_40px_rgba(0,0,0,0.88)]">
    <div class="max-w-2xl mx-auto">
      <!-- Cabeçalho do Nó -->
      <div class="flex items-start justify-between gap-3 mb-2">
        <div class="flex items-center gap-3">
          <div id="hud-node-icon-box" class="w-11 h-11 flex items-center justify-center shrink-0"></div>
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 id="hud-node-title" class="font-hud font-bold text-lg sm:text-xl text-white tracking-wide leading-tight">Título</h3>
              <span id="hud-node-badge" class="text-[10px] font-hud font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-slate-800 text-slate-300">Status</span>
            </div>
            <div class="flex flex-wrap items-center gap-2 mt-0.5 text-xs text-slate-400">
              <span id="hud-node-meta" class="font-hud font-semibold uppercase tracking-wider text-cyan-400">Meta info</span>
              <span id="hud-node-date-wrap" class="hidden items-center gap-1 text-emerald-400 font-medium">
                <span>•</span>
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span id="hud-node-date"></span>
              </span>
            </div>
          </div>
        </div>

        <button onclick="deselectNode()" title="Fechar Detalhes" class="p-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white transition">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Descrição / Notas -->
      <p id="hud-node-desc" class="text-xs sm:text-sm text-slate-300 mb-3.5 leading-relaxed max-h-20 overflow-y-auto">
        Notas da habilidade ou ramo.
      </p>

      <!-- Confirmação Inline de Exclusão -->
      <div id="delete-confirm-bar" class="hidden mb-3 p-2.5 rounded-xl bg-red-950/70 border border-red-500/50 flex flex-wrap items-center justify-between gap-2">
        <span id="delete-confirm-text" class="text-xs text-red-200 font-medium">Excluir este item?</span>
        <div class="flex items-center gap-1.5 shrink-0">
          <button onclick="toggleDeleteConfirm(false)" class="px-2.5 py-1 rounded-lg bg-slate-800 text-xs text-slate-300 font-semibold">Cancelar</button>
          <button id="btn-delete-keep-children" onclick="confirmDeleteSelectedNode(true)" class="hidden px-2.5 py-1 rounded-lg bg-amber-600 hover:bg-amber-500 text-xs text-white font-bold">Manter Filhos</button>
          <button id="btn-delete-all-branch" onclick="confirmDeleteSelectedNode(false)" class="px-2.5 py-1 rounded-lg bg-red-600 hover:bg-red-500 text-xs text-white font-bold">Excluir</button>
        </div>
      </div>

      <!-- Barra de Ações do Nó -->
      <div id="hud-action-grid" class="grid grid-cols-2 sm:grid-cols-5 gap-2">
        <button id="btn-cycle-status" onclick="cycleSelectedNodeStatus()" class="col-span-2 sm:col-span-1 py-2 px-2.5 rounded-xl font-hud font-bold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-1 transition shadow-md active:scale-95"></button>

        <button onclick="openNodeModal('derive')" class="py-2 px-2.5 rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 border border-cyan-400/60 text-cyan-300 font-hud font-bold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-1 transition active:scale-95">
