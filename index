      const globalStats = getSkillStats(appData.nodes);
      document.getElementById('total-xp-value').textContent = globalStats.xp;

      const sections = appData.sections;
      const N = sections.length;

      // Anel base escuro contínuo
      const baseRing = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      baseRing.setAttribute('cx', '0');
      baseRing.setAttribute('cy', '0');
      baseRing.setAttribute('r', String(RING_RADIUS));
      baseRing.setAttribute('fill', '#060a12');
      baseRing.setAttribute('stroke', '#1e293b');
      baseRing.setAttribute('stroke-width', String(RING_STROKE));
      ringLayer.appendChild(baseRing);

      // Emblema Central "SKILLS" (contra-rotaciona para permanecer sempre reto)
      const emblemGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      const titleText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      titleText.setAttribute('x', '0');
      titleText.setAttribute('y', N > 0 ? '-6' : '8');
      titleText.setAttribute('text-anchor', 'middle');
      titleText.setAttribute('fill', '#ffffff');
      titleText.setAttribute('font-family', 'Rajdhani, sans-serif');
      titleText.setAttribute('font-weight', '700');
      titleText.setAttribute('font-size', '34');
      titleText.setAttribute('letter-spacing', '6');
      titleText.textContent = 'SKILLS';
      emblemGroup.appendChild(titleText);

      if (N > 0) {
        const subText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        subText.setAttribute('x', '0');
        subText.setAttribute('y', '18');
        subText.setAttribute('text-anchor', 'middle');
        subText.setAttribute('fill', '#94a3b8');
        subText.setAttribute('font-family', 'Share Tech Mono, monospace');
        subText.setAttribute('font-size', '12');
        subText.setAttribute('letter-spacing', '1.5');
        subText.textContent = `${globalStats.completedSkills}/${globalStats.totalSkills} CONCLUÍDAS`;
        emblemGroup.appendChild(subText);
      }
      ringLayer.appendChild(emblemGroup);
      sceneRegistry.macroEmblem = emblemGroup;

      if (N === 0) return;

      const stepDeg = 360 / N;
      const gapDeg = N === 1 ? 0 : Math.min(5, stepDeg * 0.12);
      const startOffset = -90;

      sections.forEach((sec, idx) => {
        const startAngle = startOffset + idx * stepDeg + gapDeg / 2;
        const endAngle = startOffset + (idx + 1) * stepDeg - gapDeg / 2;
        const midAngle = (startAngle + endAngle) / 2;

        // Ângulos iniciais de acordo com a visão corrente (Macro ou Micro)
        const initialAngles = getTargetSectionAngles(
          idx,
          currentView,
          currentView === 'micro' ? activeSectionId : null
        );

        // Grupo da fatia do anel
        const sliceGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

        const arcPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        const d = describeArc(0, 0, RING_RADIUS, initialAngles.start, initialAngles.end, 1);

        arcPath.setAttribute('d', d);
        arcPath.setAttribute('fill', 'none');
        arcPath.setAttribute('stroke', sec.color);
        arcPath.setAttribute('stroke-width', String(RING_STROKE));
        arcPath.setAttribute('stroke-linecap', N === 1 && currentView === 'macro' ? 'round' : 'butt');
        arcPath.setAttribute('class', 'svg-arc-segment');
        arcPath.setAttribute('filter', 'url(#neon-glow)');
        arcPath.addEventListener('click', (e) => {
          e.stopPropagation();
          if (dragMoved) return;
          if (currentView === 'macro') {
            switchToMicro(sec.id);
          } else if (currentView === 'micro' && activeSectionId !== sec.id) {
            switchToMicro(sec.id);
          }
        });
        sliceGroup.appendChild(arcPath);

        // Texto curvo paralelo ao interior do anel (<textPath>)
        const normMid = ((midAngle % 360) + 360) % 360;
        const isLowerHalf = N > 1 && normMid > 0 && normMid < 180;
        const edgeMargin = N === 1 ? 0 : Math.min(4, (endAngle - startAngle) * 0.08);
        const textRadius = isLowerHalf ? 121 : 128;
        const pathId = `macro-sec-arc-${idx}`;

        let curveD = '';
        let effectiveSpanDeg = 120;

        if (N === 1) {
          curveD = describeArc(0, 0, textRadius, -150, -30, 1);
          effectiveSpanDeg = 120;
        } else if (isLowerHalf) {
          const aStart = endAngle - edgeMargin;
          const aEnd = startAngle + edgeMargin;
          curveD = describeArc(0, 0, textRadius, aStart, aEnd, 0);
          effectiveSpanDeg = Math.max(12, aStart - aEnd);
        } else {
          const aStart = startAngle + edgeMargin;
          const aEnd = endAngle - edgeMargin;
          curveD = describeArc(0, 0, textRadius, aStart, aEnd, 1);
          effectiveSpanDeg = Math.max(12, aEnd - aStart);
        }

        const defPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        defPath.setAttribute('id', pathId);
        defPath.setAttribute('d', curveD);
        defPath.setAttribute('fill', 'none');
        textPathsDefs.appendChild(defPath);

        const arcLength = textRadius * degToRad(effectiveSpanDeg);
        const rawLabel = sec.name.toUpperCase();
        const maxFontByArc = (arcLength * 0.88) / Math.max(1, rawLabel.length * 0.62);
        const fontSize = Math.max(7.5, Math.min(12.5, maxFontByArc));
        const maxChars = Math.max(4, Math.floor((arcLength * 0.92) / (fontSize * 0.62)));
        const displayLabel = rawLabel.length > maxChars ? rawLabel.slice(0, maxChars - 1) + '…' : rawLabel;

        const curvedText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        curvedText.setAttribute('fill', sec.color);
        curvedText.setAttribute('font-family', 'Rajdhani, sans-serif');
        curvedText.setAttribute('font-weight', '700');
        curvedText.setAttribute('font-size', fontSize.toFixed(1));
        curvedText.setAttribute('letter-spacing', '1.3');
        curvedText.setAttribute('pointer-events', 'none');

        const textPathEl = document.createElementNS('http://www.w3.org/2000/svg', 'textPath');
        textPathEl.setAttribute('href', `#${pathId}`);
        textPathEl.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', `#${pathId}`);
        textPathEl.setAttribute('startOffset', '50%');
        textPathEl.setAttribute('text-anchor', 'middle');
        textPathEl.textContent = displayLabel;

        curvedText.appendChild(textPathEl);
        sliceGroup.appendChild(curvedText);
        ringLayer.appendChild(sliceGroup);

        // Grupo persistente da árvore desta seção
        const treeGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        const edgesSubGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        const nodesSubGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        treeGroup.appendChild(edgesSubGroup);
        treeGroup.appendChild(nodesSubGroup);
        treesLayer.appendChild(treeGroup);

        sceneRegistry.sections.set(sec.id, {
          idx,
          sec,
          sliceGroup,
          arcPath,
          curvedText,
          treeGroup,
          midAngle,
          currStart: initialAngles.start,
          currEnd: initialAngles.end,
          fromStart: initialAngles.start,
          fromEnd: initialAngles.end,
          toStart: initialAngles.start,
          toEnd: initialAngles.end
        });

        // Calcula coordenadas polares concêntricas (Macro & Micro) sem sobreposição
        const secNodes = appData.nodes.filter(n => n.sectionId === sec.id);
        const rootNodes = secNodes.filter(n => !n.parentId);
        if (rootNodes.length === 0) return;

        const weights = rootNodes.map(r => computeSubtreeWeight(r.id, secNodes));
        const totalWeight = weights.reduce((a, b) => a + b, 0);
        const maxDepth = Math.max(...rootNodes.map(r => computeMaxSubtreeDepth(r.id, secNodes)));

        // Leque angular polar: mantém todos os ramos confortavelmente dentro do semicírculo expandido (176°)
        const macroWedge = Math.min(stepDeg * 0.84, 78);
        const microWedge = Math.min(156, Math.max(48, totalWeight * 31));

        // Passo radial dinâmico: garante folga >= 82px entre folhas e acomoda múltiplos ramos no raio inicial
        const minArcSpacing = 82;
        const baseMicroR1 = Math.max(
          RING_RADIUS + 100,
          Math.ceil((rootNodes.length * 76) / Math.max(0.5, degToRad(microWedge)))
        );
        const requiredRadiusForLeaves = (totalWeight * minArcSpacing) / Math.max(0.5, degToRad(microWedge));
        const microRingStep = Math.max(
          90,
          maxDepth > 1 ? Math.ceil((requiredRadiusForLeaves - baseMicroR1) / (maxDepth - 1)) : 90
        );

        let macroCursor = midAngle - macroWedge / 2;
        let microCursor = midAngle - microWedge / 2;

        rootNodes.forEach((root, rIdx) => {
          const w = weights[rIdx];
          const macroSpan = (w / totalWeight) * macroWedge;
          const microSpan = (w / totalWeight) * microWedge;

          const macroStart = macroCursor;
          const macroEnd = macroCursor + macroSpan;
          const microStart = microCursor;
          const microEnd = microCursor + microSpan;

          macroCursor = macroEnd;
          microCursor = microEnd;

          const macroRootAngle = (macroStart + macroEnd) / 2;
          const microRootAngle = (microStart + microEnd) / 2;

          const macroAnchor = polarToCartesian(0, 0, RING_RADIUS + 10, macroRootAngle);
          const microAnchor = polarToCartesian(0, 0, RING_RADIUS + 10, microRootAngle);

          buildNodeTreeElements(
            sec,
            secNodes,
            root,
            null,
            { macroAnchor, microAnchor },
            macroStart,
            macroEnd,
            microStart,
            microEnd,
            1,
            baseMicroR1,
            microRingStep,
            edgesSubGroup,
            nodesSubGroup
          );
        });
      });

      // Cabeçalho upright dentro do arco ativo (exibido quando zoomed-in na seção)
      const hudGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      const arcTitle = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      arcTitle.setAttribute('x', '0');
      arcTitle.setAttribute('y', '0');
      arcTitle.setAttribute('text-anchor', 'middle');
      arcTitle.setAttribute('font-family', 'Rajdhani, sans-serif');
      arcTitle.setAttribute('font-weight', '700');
      arcTitle.setAttribute('font-size', '20');
      arcTitle.setAttribute('letter-spacing', '1.4');

      const arcSub = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      arcSub.setAttribute('x', '0');
      arcSub.setAttribute('y', '24');
      arcSub.setAttribute('text-anchor', 'middle');
      arcSub.setAttribute('fill', '#94a3b8');
      arcSub.setAttribute('font-family', 'Share Tech Mono, monospace');
      arcSub.setAttribute('font-size', '10');
      arcSub.setAttribute('letter-spacing', '0.9');

      hudGroup.appendChild(arcTitle);
      hudGroup.appendChild(arcSub);
      activeArcLayer.appendChild(hudGroup);
      sceneRegistry.activeArcHud = { group: hudGroup, titleEl: arcTitle, subEl: arcSub };

      // Aplica o estado atual da câmera imediatamente ao DOM recém-construído
      applySceneFrame();
    }

    // Constrói recursivamente os elementos vetoriais de cada nó em arcos polares concêntricos
    function buildNodeTreeElements(
      sec,
      secNodes,
      node,
      parentNodeId,
      rootAnchors,
      macroStartAngle,
      macroEndAngle,
      microStartAngle,
      microEndAngle,
      depth,
      baseMicroR1,
      microRingStep,
      edgesSubGroup,
      nodesSubGroup
    ) {
      // Cada nó ocupa o ângulo bissetor exato do setor polar reservado às suas folhas
      const macroAngle = (macroStartAngle + macroEndAngle) / 2;
      const microAngle = (microStartAngle + microEndAngle) / 2;

      const macroRadius = RING_RADIUS + 56 + (depth - 1) * 44;
      const microRadius = baseMicroR1 + (depth - 1) * microRingStep;

      const macroPos = polarToCartesian(0, 0, macroRadius, macroAngle);
      const microPos = polarToCartesian(0, 0, microRadius, microAngle);

      const isCategory = node.nodeType === 'category';
      const isCompleted = !isCategory && node.status === 'completed';
      const isInProgress = !isCategory && node.status === 'in_progress';
      const isSelected = node.id === selectedNodeId;

      // Linha de conexão (Edge)
      const edgeEl = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      let edgeColor = '#334155';
      let edgeWidth = '2';
      let edgeOpacity = '0.78';

      if (isCategory) {
        edgeColor = sec.color;
        edgeWidth = '2.4';
        edgeOpacity = '0.72';
      } else if (isCompleted) {
        edgeColor = sec.color;
        edgeWidth = '2.8';
        edgeOpacity = '0.95';
      } else if (isInProgress) {
        edgeColor = '#cbd5e1';
        edgeWidth = '2.2';
        edgeOpacity = '0.88';
      }

      edgeEl.setAttribute('stroke', edgeColor);
      edgeEl.setAttribute('stroke-width', edgeWidth);
      edgeEl.setAttribute('stroke-opacity', edgeOpacity);
      edgeEl.setAttribute('stroke-linecap', 'round');
      if (isCompleted) {
        edgeEl.setAttribute('filter', 'url(#neon-glow)');
      }
      edgesSubGroup.appendChild(edgeEl);

      // Grupo principal do nó (posicionado em (x, y))
      const nodeGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      nodeGroup.setAttribute('class', 'svg-node-group');
      nodeGroup.addEventListener('click', (e) => {
        e.stopPropagation();
        if (dragMoved) return;
        if (currentView === 'macro') {
          switchToMicro(sec.id);
        } else {
          selectNode(node.id);
        }
      });

      // Subgrupo contra-rotacionado (mantém ícone e etiqueta sempre nivelados)
      const uprightGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');

      // Retículo pulsante se selecionado
      if (isSelected) {
        if (isCategory) {
          const reticleHex = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
          reticleHex.setAttribute('points', polygonPoints(0, 0, 29, 6, -90));
          reticleHex.setAttribute('fill', 'none');
          reticleHex.setAttribute('stroke', '#ffffff');
          reticleHex.setAttribute('stroke-width', '1.8');
          reticleHex.setAttribute('stroke-dasharray', '5 3');
          reticleHex.setAttribute('class', 'node-selection-reticle');
          uprightGroup.appendChild(reticleHex);
        } else {
          const reticleCirc = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          reticleCirc.setAttribute('cx', '0');
          reticleCirc.setAttribute('cy', '0');
          reticleCirc.setAttribute('r', '25');
          reticleCirc.setAttribute('fill', 'none');
          reticleCirc.setAttribute('stroke', '#ffffff');
          reticleCirc.setAttribute('stroke-width', '1.8');
          reticleCirc.setAttribute('stroke-dasharray', '5 3');
          reticleCirc.setAttribute('class', 'node-selection-reticle');
          uprightGroup.appendChild(reticleCirc);
        }
      }

      // Forma do Nó: Hexágono Duplo para Ramo/Subcategoria vs Círculo para Habilidade/Conquista
      let iconStroke = '#94a3b8';

      if (isCategory) {
        const outerHex = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        outerHex.setAttribute('points', polygonPoints(0, 0, 23, 6, -90));
        outerHex.setAttribute('fill', '#090d16');
        outerHex.setAttribute('stroke', sec.color);
        outerHex.setAttribute('stroke-width', '2.4');
        outerHex.setAttribute('filter', 'url(#neon-glow)');
        uprightGroup.appendChild(outerHex);

        const innerHex = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        innerHex.setAttribute('points', polygonPoints(0, 0, 17, 6, -90));
        innerHex.setAttribute('fill', 'none');
        innerHex.setAttribute('stroke', sec.color);
        innerHex.setAttribute('stroke-opacity', '0.55');
        innerHex.setAttribute('stroke-width', '1.2');
        uprightGroup.appendChild(innerHex);

        iconStroke = sec.color;
      } else {
        const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        circle.setAttribute('cx', '0');
        circle.setAttribute('cy', '0');
        circle.setAttribute('r', '19');

        if (isCompleted) {
          circle.setAttribute('fill', sec.color);
          circle.setAttribute('stroke', '#ffffff');
          circle.setAttribute('stroke-width', '2.2');
          circle.setAttribute('filter', 'url(#neon-glow)');
          iconStroke = '#05080d';
        } else if (isInProgress) {
          circle.setAttribute('fill', '#0d1524');
          circle.setAttribute('stroke', '#ffffff');
          circle.setAttribute('stroke-width', '2.5');
          iconStroke = '#ffffff';
        } else {
          circle.setAttribute('fill', '#090d16');
          circle.setAttribute('stroke', '#475569');
          circle.setAttribute('stroke-width', '1.8');
          iconStroke = '#64748b';
        }
        uprightGroup.appendChild(circle);
      }

      // Ícone Vetorial Centralizado
      const iconSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      iconSvg.setAttribute('x', '-10');
      iconSvg.setAttribute('y', '-10');
      iconSvg.setAttribute('width', '20');
      iconSvg.setAttribute('height', '20');
      iconSvg.setAttribute('viewBox', '0 0 24 24');
      iconSvg.setAttribute('fill', 'none');
      iconSvg.setAttribute('stroke', iconStroke);
      iconSvg.setAttribute('stroke-width', '2.1');
      iconSvg.setAttribute('stroke-linecap', 'round');
      iconSvg.setAttribute('stroke-linejoin', 'round');
      iconSvg.innerHTML = ICON_LIBRARY[node.icon] || ICON_LIBRARY.star;
      uprightGroup.appendChild(iconSvg);

      // Etiqueta do Nó (Visível na Visão Micro)
      const labelGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      const rawText = isCategory ? node.title.toUpperCase() : node.title;
      const shortLabel = rawText.length > 18 ? rawText.slice(0, 17) + '…' : rawText;

      if (isCategory) {
        const pillW = Math.max(54, shortLabel.length * 6.8 + 16);
        const pillRect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        pillRect.setAttribute('x', (-pillW / 2).toFixed(1));
        pillRect.setAttribute('y', '26');
        pillRect.setAttribute('width', pillW.toFixed(1));
        pillRect.setAttribute('height', '16');
        pillRect.setAttribute('rx', '4');
        pillRect.setAttribute('fill', '#070b13');
        pillRect.setAttribute('stroke', sec.color);
        pillRect.setAttribute('stroke-opacity', '0.75');
        pillRect.setAttribute('stroke-width', '1.1');
        labelGroup.appendChild(pillRect);

        const labelEl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        labelEl.setAttribute('x', '0');
        labelEl.setAttribute('y', '37.2');
        labelEl.setAttribute('text-anchor', 'middle');
        labelEl.setAttribute('fill', '#ffffff');
        labelEl.setAttribute('font-family', 'Rajdhani, sans-serif');
        labelEl.setAttribute('font-weight', '700');
        labelEl.setAttribute('font-size', '10.5');
        labelEl.setAttribute('letter-spacing', '0.9');
        labelEl.textContent = shortLabel;
        labelGroup.appendChild(labelEl);
      } else {
        const labelEl = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        labelEl.setAttribute('x', '0');
        labelEl.setAttribute('y', '31');
        labelEl.setAttribute('text-anchor', 'middle');
        labelEl.setAttribute('fill', isCompleted ? '#f8fafc' : isInProgress ? '#e2e8f0' : '#94a3b8');
        labelEl.setAttribute('font-family', 'Inter, sans-serif');
        labelEl.setAttribute('font-weight', isCompleted ? '600' : '500');
        labelEl.setAttribute('font-size', '9.5');
        labelEl.textContent = shortLabel;
        labelGroup.appendChild(labelEl);
      }

      uprightGroup.appendChild(labelGroup);
      nodeGroup.appendChild(uprightGroup);
      nodesSubGroup.appendChild(nodeGroup);

      sceneRegistry.nodes.set(node.id, {
        node,
        parentNodeId,
        anchorPos: rootAnchors,
        group: nodeGroup,
        uprightGroup,
        edgeEl,
        labelGroup,
        macroPos,
        microPos,
        macroScale: 0.62,
        microScale: 1.0
      });

      // Recursão para os nós filhos derivados: particiona o setor polar proporcionalmente às folhas
      const children = secNodes.filter(n => n.parentId === node.id);
      if (children.length === 0) return;

      const childWeights = children.map(c => computeSubtreeWeight(c.id, secNodes));
      const totalChildWeight = childWeights.reduce((a, b) => a + b, 0);

      let childMacroCursor = macroStartAngle;
      let childMicroCursor = microStartAngle;

      children.forEach((child, idx) => {
        const cw = childWeights[idx];
        const cMacroSpan = (cw / totalChildWeight) * (macroEndAngle - macroStartAngle);
        const cMicroSpan = (cw / totalChildWeight) * (microEndAngle - microStartAngle);

        const cMacroStart = childMacroCursor;
        const cMacroEnd = childMacroCursor + cMacroSpan;
        const cMicroStart = childMicroCursor;
        const cMicroEnd = childMicroCursor + cMicroSpan;

        childMacroCursor = cMacroEnd;
        childMicroCursor = cMicroEnd;

        buildNodeTreeElements(
          sec,
          secNodes,
          child,
          node.id,
          rootAnchors,
          cMacroStart,
          cMacroEnd,
          cMicroStart,
          cMicroEnd,
          depth + 1,
          baseMicroR1,
          microRingStep,
          edgesSubGroup,
          nodesSubGroup
        );
      });
    }

    // 8. MOTOR DE ANIMAÇÃO 60FPS E RENDERIZAÇÃO DO FRAME
    function startCameraAnimation(
      targetState,
      durationMs = 560,
      onComplete = null,
      targetMode = currentView,
      targetActiveSecId = activeSectionId
    ) {
      // Prepara a interpolação contínua dos arcos de cada seção (sem saltos de 360°)
      sceneRegistry.sections.forEach((secEntry) => {
        secEntry.fromStart = secEntry.currStart;
        secEntry.fromEnd = secEntry.currEnd;

        const targetArc = getTargetSectionAngles(secEntry.idx, targetMode, targetActiveSecId);
        const fromMid = (secEntry.fromStart + secEntry.fromEnd) / 2;
        const rawToMid = (targetArc.start + targetArc.end) / 2;
        const alignedToMid = fromMid + shortestAngleDelta(fromMid, rawToMid);
        const targetSpan = targetArc.end - targetArc.start;

        secEntry.toStart = alignedToMid - targetSpan / 2;
        secEntry.toEnd = alignedToMid + targetSpan / 2;
      });

      cameraAnim = {
        startTime: performance.now(),
        duration: durationMs,
        from: { ...camera },
        to: {
          zoom: targetState.zoom !== undefined ? targetState.zoom : camera.zoom,
          panX: targetState.panX !== undefined ? targetState.panX : camera.panX,
          panY: targetState.panY !== undefined ? targetState.panY : camera.panY,
          rotDeg: targetState.rotDeg !== undefined ? targetState.rotDeg : camera.rotDeg,
          morphT: targetState.morphT !== undefined ? targetState.morphT : camera.morphT,
          secBlendT: targetState.secBlendT !== undefined ? targetState.secBlendT : camera.secBlendT
        },
        onComplete
      };
      if (!rafId) {
        rafId = requestAnimationFrame(animationTick);
      }
    }

    function animationTick(now) {
      if (!cameraAnim) {
        rafId = null;
        return;
      }

      const elapsed = now - cameraAnim.startTime;
      const rawT = clamp01(elapsed / cameraAnim.duration);
      const easeT = easeInOutCubic(rawT);

      camera.zoom = lerp(cameraAnim.from.zoom, cameraAnim.to.zoom, easeT);
      camera.panX = lerp(cameraAnim.from.panX, cameraAnim.to.panX, easeT);
      camera.panY = lerp(cameraAnim.from.panY, cameraAnim.to.panY, easeT);
      camera.rotDeg = lerp(cameraAnim.from.rotDeg, cameraAnim.to.rotDeg, easeT);
      camera.morphT = lerp(cameraAnim.from.morphT, cameraAnim.to.morphT, easeT);
      camera.secBlendT = lerp(cameraAnim.from.secBlendT, cameraAnim.to.secBlendT, easeT);

      sceneRegistry.sections.forEach((secEntry) => {
        secEntry.currStart = lerp(secEntry.fromStart, secEntry.toStart, easeT);
        secEntry.currEnd = lerp(secEntry.fromEnd, secEntry.toEnd, easeT);
      });

      applySceneFrame();

      if (rawT < 1) {
        rafId = requestAnimationFrame(animationTick);
      } else {
        const doneCb = cameraAnim.onComplete;
        cameraAnim = null;
        rafId = null;
        if (doneCb) doneCb();
      }
    }

    function applySceneFrame() {
      const rig = document.getElementById('camera-rig');
      if (!rig) return;

      const { zoom, panX, panY, rotDeg, morphT, secBlendT } = camera;
      rig.setAttribute(
        'transform',
        `translate(${panX.toFixed(2)}, ${panY.toFixed(2)}) scale(${zoom.toFixed(4)}) rotate(${rotDeg.toFixed(2)})`
      );

      // Luz ambiental radial acompanha a cor da seção ativa na Visão Micro
      const ambientGlow = document.getElementById('ambient-glow');
      const activeEntry = activeSectionId ? sceneRegistry.sections.get(activeSectionId) : null;
      if (ambientGlow) {
        if (activeEntry && morphT > 0.05) {
          ambientGlow.setAttribute('fill', activeEntry.sec.color);
          ambientGlow.setAttribute('opacity', (0.06 + morphT * 0.1).toFixed(3));
        } else {
          ambientGlow.setAttribute('fill', '#00e5ff');
          ambientGlow.setAttribute('opacity', '0.06');
        }
      }

      // Emblema central "SKILLS": permanece nivelado e desaparece ao entrar em uma seção
      if (sceneRegistry.macroEmblem) {
        const emblemOpacity = clamp01(1 - morphT * 2.6);
        sceneRegistry.macroEmblem.setAttribute('transform', `rotate(${(-rotDeg).toFixed(2)})`);
        sceneRegistry.macroEmblem.setAttribute('opacity', emblemOpacity.toFixed(3));
        sceneRegistry.macroEmblem.style.display = emblemOpacity <= 0.005 ? 'none' : 'inline';
      }

      // Atualiza opacidade e geometria das fatias do anel (expansão para semicírculo 180° na Visão Micro)
      const totalSectionsCount = appData.sections.length;
      sceneRegistry.sections.forEach((secEntry, secId) => {
        let treeOpacity = 1;
        let sliceOpacity = 1;

        if (morphT > 0.001) {
          if (secId === activeSectionId) {
            treeOpacity = lerp(1, secBlendT, morphT);
            sliceOpacity = lerp(1, 0.4 + 0.6 * secBlendT, morphT);
          } else if (secId === prevSectionId && secBlendT < 1) {
            treeOpacity = lerp(1, 1 - secBlendT, morphT);
            sliceOpacity = lerp(1, 0.35 + 0.65 * (1 - secBlendT), morphT);
          } else {
            treeOpacity = clamp01(1 - morphT * 1.65);
            sliceOpacity = lerp(1, 0.38, morphT);
          }
        }

        // Atualiza o arco vetorial interpolado da fatia
        secEntry.arcPath.setAttribute(
          'd',
          describeArc(0, 0, RING_RADIUS, secEntry.currStart, secEntry.currEnd, 1)
        );
        secEntry.arcPath.setAttribute(
          'stroke-linecap',
          totalSectionsCount === 1 && morphT < 0.04 ? 'round' : 'butt'
        );

        secEntry.sliceGroup.setAttribute('opacity', sliceOpacity.toFixed(3));
        secEntry.treeGroup.setAttribute('opacity', treeOpacity.toFixed(3));
        secEntry.treeGroup.style.pointerEvents = treeOpacity > 0.35 ? 'auto' : 'none';

        // Texto curvo dentro da fatia dissolve cedo ao entrar na seção para nunca colidir
        const curvedOpacity = clamp01(1 - morphT * 2.35);
        secEntry.curvedText.setAttribute('opacity', curvedOpacity.toFixed(3));

        // Intensifica o brilho do arco ativo
        if (secId === activeSectionId && morphT > 0.4) {
          secEntry.arcPath.setAttribute('filter', 'url(#strong-glow)');
        } else {
          secEntry.arcPath.setAttribute('filter', 'url(#neon-glow)');
        }
      });

      // Atualiza posições interpoladas de todos os nós e linhas de conexão
      sceneRegistry.nodes.forEach((nEntry) => {
        const x = lerp(nEntry.macroPos.x, nEntry.microPos.x, morphT);
        const y = lerp(nEntry.macroPos.y, nEntry.microPos.y, morphT);
        const sc = lerp(nEntry.macroScale, nEntry.microScale, morphT);

        nEntry.group.setAttribute('transform', `translate(${x.toFixed(2)}, ${y.toFixed(2)}) scale(${sc.toFixed(3)})`);
        nEntry.uprightGroup.setAttribute('transform', `rotate(${(-rotDeg).toFixed(2)})`);

        // Etiquetas aparecem suavemente conforme a árvore expande
        const labelOpacity = clamp01((morphT - 0.35) / 0.65);
        nEntry.labelGroup.setAttribute('opacity', labelOpacity.toFixed(3));

        // Atualiza extremidades da linha de conexão
        let p1 = null;
        if (nEntry.parentNodeId) {
          const parentEntry = sceneRegistry.nodes.get(nEntry.parentNodeId);
          if (parentEntry) {
            p1 = {
              x: lerp(parentEntry.macroPos.x, parentEntry.microPos.x, morphT),
              y: lerp(parentEntry.macroPos.y, parentEntry.microPos.y, morphT)
            };
          }
        }
        if (!p1) {
          p1 = {
            x: lerp(nEntry.anchorPos.macroAnchor.x, nEntry.anchorPos.microAnchor.x, morphT),
            y: lerp(nEntry.anchorPos.macroAnchor.y, nEntry.anchorPos.microAnchor.y, morphT)
          };
        }

        nEntry.edgeEl.setAttribute('x1', p1.x.toFixed(2));
        nEntry.edgeEl.setAttribute('y1', p1.y.toFixed(2));
        nEntry.edgeEl.setAttribute('x2', x.toFixed(2));
        nEntry.edgeEl.setAttribute('y2', y.toFixed(2));
      });

      // Cabeçalho interno upright dentro do arco da seção ativa (ajustado à corda interna)
      if (sceneRegistry.activeArcHud) {
        const hud = sceneRegistry.activeArcHud;
        if (activeEntry && morphT > 0.05) {
          const hudOpacity = clamp01((morphT - 0.45) / 0.55) * secBlendT;

          // Raio interno livre do traço neon: RING_RADIUS (156) - RING_STROKE/2 (11) = 145
          const innerRingRadius = RING_RADIUS - RING_STROKE / 2;
          // Posiciona o bloco de texto na zona larga da corda interna (d = 76 a partir do centro)
          const radialOffset = 76;
          const posLocal = polarToCartesian(0, 0, radialOffset, activeEntry.midAngle);

          hud.group.setAttribute(
            'transform',
            `translate(${posLocal.x.toFixed(1)}, ${posLocal.y.toFixed(1)}) rotate(${(-rotDeg).toFixed(2)})`
          );
          hud.group.setAttribute('opacity', hudOpacity.toFixed(3));
          hud.titleEl.setAttribute('fill', activeEntry.sec.color);

          // Calcula a largura exata da corda horizontal interna nesta altura e subtrai 48px de respiro (24px cada lado)
          const chordWidth = 2 * Math.sqrt(Math.max(0, innerRingRadius * innerRingRadius - radialOffset * radialOffset));
          const safeTextWidth = Math.max(110, chordWidth - 48);

          const rawTitle = activeEntry.sec.name.toUpperCase().trim();
          let lines = [rawTitle];

          // Quebra automaticamente em 2 linhas equilibradas se o título for muito extenso
          if (rawTitle.length > 15 && rawTitle.includes(' ')) {
            const words = rawTitle.split(/\s+/);
            let bestSplit = 1;
            let bestDiff = Infinity;
            for (let i = 1; i < words.length; i++) {
              const l1 = words.slice(0, i).join(' ');
              const l2 = words.slice(i).join(' ');
              const diff = Math.abs(l1.length - l2.length);
              if (diff < bestDiff) {
                bestDiff = diff;
                bestSplit = i;
              }
            }
            lines = [words.slice(0, bestSplit).join(' '), words.slice(bestSplit).join(' ')];
          }

          const longestLineLen = Math.max(...lines.map(l => l.length));
          const letterSpacing = longestLineLen > 14 ? 0.9 : 1.3;
          const maxFontAllowed = lines.length > 1 ? 16.5 : 19.5;
          const computedFont = Math.min(
            maxFontAllowed,
            Math.max(11.5, (safeTextWidth - longestLineLen * letterSpacing) / Math.max(1, longestLineLen * 0.62))
          );

          hud.titleEl.setAttribute('font-size', computedFont.toFixed(1));
          hud.titleEl.setAttribute('letter-spacing', letterSpacing.toFixed(1));
          hud.titleEl.innerHTML = '';

          if (lines.length === 1) {
            hud.titleEl.setAttribute('y', '0');
            hud.titleEl.textContent = lines[0];
            hud.subEl.setAttribute('y', '20');
          } else {
            hud.titleEl.setAttribute('y', '-8');
            lines.forEach((lineStr, lineIdx) => {
              const tspan = document.createElementNS('http://www.w3.org/2000/svg', 'tspan');
              tspan.setAttribute('x', '0');
              tspan.setAttribute('dy', lineIdx === 0 ? '0' : (computedFont * 1.12).toFixed(1));
              tspan.textContent = lineStr;
              hud.titleEl.appendChild(tspan);
            });
            hud.subEl.setAttribute('y', (computedFont * 1.12 + 12).toFixed(1));
          }

          const secNodes = appData.nodes.filter(n => n.sectionId === activeEntry.sec.id);
          const secStats = getSkillStats(secNodes);
          const subStr = `${secStats.completedSkills}/${secStats.totalSkills} HABILIDADES • ${secStats.xp} XP`;
          const subFont = Math.min(10, Math.max(8, (safeTextWidth + 24) / Math.max(1, subStr.length * 0.64)));
          hud.subEl.setAttribute('font-size', subFont.toFixed(1));
          hud.subEl.textContent = subStr;
        } else {
          hud.group.setAttribute('opacity', '0');
        }
      }

      updateRecenterButtonState();
    }

    function updateRecenterButtonState() {
      const btn = document.getElementById('btn-recenter-cam');
      const lbl = document.getElementById('recenter-label');
      if (!btn || !lbl) return;

      let isOffCenter = false;
      if (currentView === 'macro') {
        isOffCenter = Math.abs(camera.panX) > 15 || Math.abs(camera.panY) > 15 || Math.abs(camera.zoom - 1) > 0.12;
      } else if (activeSectionId) {
        const canonical = getCanonicalMicroFraming(activeSectionId);
        isOffCenter =
          Math.abs(camera.panX - canonical.panX) > 25 ||
          Math.abs(camera.panY - canonical.panY) > 25 ||
          Math.abs(camera.zoom - canonical.zoom) > 0.15;
      }

      if (isOffCenter) {
        btn.classList.add('border-cyan-400/70', 'bg-cyan-950/70');
        lbl.classList.remove('hidden');
      } else {
        btn.classList.remove('border-cyan-400/70', 'bg-cyan-950/70');
        lbl.classList.add('hidden');
      }
    }

    // 9. NAVEGAÇÃO ENTRE VISÃO MACRO (ANEL) E VISÃO MICRO (SEÇÃO)
    function switchToMacro() {
      if (currentView === 'macro' && Math.abs(camera.morphT) < 0.01) {
        recenterCurrentView();
        return;
      }

      currentView = 'macro';
      deselectNode();

      // Alterna barras superiores e inferiores
      document.getElementById('macro-brand').classList.remove('hidden');
      document.getElementById('btn-back-macro').classList.add('hidden');
      document.getElementById('btn-back-macro').classList.remove('flex');

      const microNav = document.getElementById('micro-nav');
      microNav.classList.add('opacity-0', '-translate-y-3', 'pointer-events-none');
      microNav.classList.remove('pointer-events-auto');
      setTimeout(() => {
        if (currentView === 'macro') {
          microNav.classList.add('hidden');
          microNav.classList.remove('flex');
        }
      }, 280);

      document.getElementById('btn-add-section').classList.remove('hidden');
      document.getElementById('btn-add-root-bottom').classList.add('hidden');
      document.getElementById('btn-add-root-bottom').classList.remove('flex');
      document.getElementById('empty-section-hint').classList.add('hidden');

      const targetRot = camera.rotDeg + shortestAngleDelta(camera.rotDeg, 0);
      startCameraAnimation(
        {
          zoom: 1,
          panX: 0,
          panY: 0,
          rotDeg: targetRot,
          morphT: 0,
          secBlendT: 1
        },
        560,
        () => {
          activeSectionId = null;
          prevSectionId = null;
          camera.rotDeg = 0;
          applySceneFrame();
        },
        'macro',
        null
      );
    }

    function switchToMicro(sectionId) {
      const sec = appData.sections.find(s => s.id === sectionId);
      if (!sec) return;

      const isSectionSwitch = currentView === 'micro' && activeSectionId && activeSectionId !== sectionId;
      prevSectionId = isSectionSwitch ? activeSectionId : null;
      activeSectionId = sectionId;
      currentView = 'micro';
      deselectNode();

      // Atualiza HUD Superior e Inferior
      document.getElementById('macro-brand').classList.add('hidden');
      document.getElementById('btn-back-macro').classList.remove('hidden');
      document.getElementById('btn-back-macro').classList.add('flex');

      const microNav = document.getElementById('micro-nav');
      microNav.classList.remove('hidden', 'pointer-events-none');
      microNav.classList.add('flex', 'pointer-events-auto');
      requestAnimationFrame(() => {
        microNav.classList.remove('opacity-0', '-translate-y-3');
      });

      document.getElementById('btn-add-section').classList.add('hidden');
      document.getElementById('btn-add-root-bottom').classList.remove('hidden');
      document.getElementById('btn-add-root-bottom').classList.add('flex');

      updateMicroTopNav();

      const secNodes = appData.nodes.filter(n => n.sectionId === sectionId);
      document.getElementById('empty-section-hint').classList.toggle('hidden', secNodes.length > 0);

      if (isSectionSwitch) {
        camera.secBlendT = 0;
      }

      const framing = getCanonicalMicroFraming(sectionId);
      startCameraAnimation(
        {
          zoom: framing.zoom,
          panX: framing.panX,
          panY: framing.panY,
          rotDeg: framing.rotDeg,
          morphT: 1,
          secBlendT: 1
        },
        isSectionSwitch ? 460 : 580,
        () => {
          prevSectionId = null;
          applySceneFrame();
        },
        'micro',
        sectionId
      );
    }

    function navigateSection(dir) {
      if (appData.sections.length <= 1) return;
      const idx = appData.sections.findIndex(s => s.id === activeSectionId);
      if (idx === -1) return;
      const nextIdx = (idx + dir + appData.sections.length) % appData.sections.length;
      switchToMicro(appData.sections[nextIdx].id);
    }

    function zoomBy(factor) {
      cameraAnim = null;
      camera.zoom = Math.min(4.2, Math.max(0.45, camera.zoom * factor));
      applySceneFrame();
    }

    function recenterCurrentView() {
      if (currentView === 'macro') {
        const targetRot = camera.rotDeg + shortestAngleDelta(camera.rotDeg, 0);
        startCameraAnimation({ zoom: 1, panX: 0, panY: 0, rotDeg: targetRot, morphT: 0 }, 380, null, 'macro', null);
      } else if (activeSectionId) {
        const framing = getCanonicalMicroFraming(activeSectionId);
        startCameraAnimation(
          {
            zoom: framing.zoom,
            panX: framing.panX,
            panY: framing.panY,
            rotDeg: framing.rotDeg,
            morphT: 1
          },
          380,
          null,
          'micro',
          activeSectionId
        );
      }
    }

    function updateMicroTopNav() {
      if (!activeSectionId) return;
      const idx = appData.sections.findIndex(s => s.id === activeSectionId);
      if (idx === -1) return;

      const sec = appData.sections[idx];
      const titleEl = document.getElementById('micro-sec-title');
      titleEl.textContent = sec.name;
      titleEl.style.color = sec.color;

      const secNodes = appData.nodes.filter(n => n.sectionId === sec.id);
      const stats = getSkillStats(secNodes);
      document.getElementById('micro-sec-progress').textContent =
        `${stats.completedSkills}/${stats.totalSkills} HABILIDADES • ${stats.xp} XP`;

      const dotsWrap = document.getElementById('section-dots');
      dotsWrap.innerHTML = '';
      appData.sections.forEach((s) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.title = s.name;
        const isCurrent = s.id === sec.id;
        dot.className = `rounded-full transition-all cursor-pointer ${isCurrent ? 'w-2.5 h-2.5' : 'w-2 h-2 opacity-45 hover:opacity-90'}`;
        dot.style.backgroundColor = isCurrent ? s.color : '#94a3b8';
        dot.onclick = () => {
          if (!isCurrent) switchToMicro(s.id);
        };
        dotsWrap.appendChild(dot);
      });

      if (appData.sections.length > 1) {
        const prevSec = appData.sections[(idx - 1 + appData.sections.length) % appData.sections.length];
        const nextSec = appData.sections[(idx + 1) % appData.sections.length];
        document.getElementById('prev-sec-label').textContent = prevSec.name;
        document.getElementById('next-sec-label').textContent = nextSec.name;
      } else {
        document.getElementById('prev-sec-label').textContent = '';
        document.getElementById('next-sec-label').textContent = '';
      }
    }

    // 10. SELEÇÃO DE NÓ E PAINEL INFERIOR HUD
    function selectNode(nodeId) {
      selectedNodeId = nodeId;
      toggleDeleteConfirm(false);
      rebuildSceneDOM();
      updateNodeHudDrawer();
    }

    function deselectNode() {
      if (!selectedNodeId) return;
      selectedNodeId = null;
      toggleDeleteConfirm(false);
      rebuildSceneDOM();
      updateNodeHudDrawer();
    }

    function updateNodeHudDrawer() {
      const drawer = document.getElementById('node-hud-drawer');
      const bottomBar = document.getElementById('bottom-hud-bar');
      if (!selectedNodeId) {
        drawer.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        if (bottomBar) bottomBar.classList.remove('opacity-0', 'pointer-events-none');
        return;
      }

      const node = appData.nodes.find(n => n.id === selectedNodeId);
      if (!node) {
        drawer.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
        if (bottomBar) bottomBar.classList.remove('opacity-0', 'pointer-events-none');
        return;
      }

      const sec = appData.sections.find(s => s.id === node.sectionId) || { color: '#00e5ff' };
      const isCategory = node.nodeType === 'category';
      drawer.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
      if (bottomBar) bottomBar.classList.add('opacity-0', 'pointer-events-none');

      // Caixa do Ícone no Drawer
      const iconBox = document.getElementById('hud-node-icon-box');
      if (isCategory) {
        iconBox.innerHTML = `
          <svg class="w-11 h-11" viewBox="0 0 48 48">
            <polygon points="24,3 42,13.5 42,34.5 24,45 6,34.5 6,13.5" fill="#090d16" stroke="${sec.color}" stroke-width="2.5"/>
            <svg x="13" y="13" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="${sec.color}" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              ${ICON_LIBRARY[node.icon] || ICON_LIBRARY.star}
            </svg>
          </svg>`;
      } else {
        const fillBg = node.status === 'completed' ? sec.color : '#090d16';
        const strokeCol = node.status === 'planned' ? '#64748b' : '#ffffff';
        const iconCol = node.status === 'completed' ? '#05080d' : '#ffffff';
        iconBox.innerHTML = `
          <svg class="w-11 h-11" viewBox="0 0 48 48">
            <circle cx="24" cy="24" r="20" fill="${fillBg}" stroke="${strokeCol}" stroke-width="2.4"/>
            <svg x="13" y="13" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="${iconCol}" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
              ${ICON_LIBRARY[node.icon] || ICON_LIBRARY.star}
            </svg>
          </svg>`;
      }

      document.getElementById('hud-node-title').textContent = node.title;
      document.getElementById('hud-node-desc').textContent =
        node.description || (isCategory ? 'Subcategoria / agrupador de habilidades.' : 'Nenhuma nota adicional registrada.');

      const badge = document.getElementById('hud-node-badge');
      const meta = document.getElementById('hud-node-meta');
      const dateWrap = document.getElementById('hud-node-date-wrap');
      const cycleBtn = document.getElementById('btn-cycle-status');
      const actionGrid = document.getElementById('hud-action-grid');

      if (isCategory) {
        badge.textContent = 'RAMO / SUBCATEGORIA';
        badge.className = 'text-[10px] font-hud font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-cyan-950/90 border border-cyan-500/40 text-cyan-300';

        const descendants = getDescendantNodes(node.id);
        const branchStats = getSkillStats(descendants);
        meta.textContent = `${branchStats.completedSkills}/${branchStats.totalSkills} HABILIDADES CONCLUÍDAS • ${branchStats.xp} XP`;
        meta.style.color = sec.color;

        dateWrap.classList.add('hidden');
        dateWrap.classList.remove('flex');

        cycleBtn.classList.add('hidden');
        actionGrid.classList.remove('sm:grid-cols-5');
        actionGrid.classList.add('sm:grid-cols-4');
      } else {
        const tier = DIFFICULTY_TIERS[node.difficulty] || DIFFICULTY_TIERS[3];
        meta.textContent = `NÍVEL ${node.difficulty}: ${tier.label} • +${tier.xp} XP`;
        meta.style.color = sec.color;

        if (node.completedDate) {
          const [y, m, d] = node.completedDate.split('-');
          document.getElementById('hud-node-date').textContent = y && m && d ? `${d}/${m}/${y}` : node.completedDate;
          dateWrap.classList.remove('hidden');
          dateWrap.classList.add('flex');
        } else {
          dateWrap.classList.add('hidden');
          dateWrap.classList.remove('flex');
        }

        cycleBtn.classList.remove('hidden');
        actionGrid.classList.remove('sm:grid-cols-4');
        actionGrid.classList.add('sm:grid-cols-5');

        if (node.status === 'completed') {
          badge.textContent = 'CONCLUÍDA';
          badge.className = 'text-[10px] font-hud font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-emerald-950 border border-emerald-500/50 text-emerald-300';
          cycleBtn.innerHTML = `<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Concluída</span>`;
          cycleBtn.style.backgroundColor = sec.color;
          cycleBtn.style.color = '#05080d';
        } else if (node.status === 'in_progress') {
          badge.textContent = 'EM ANDAMENTO';
          badge.className = 'text-[10px] font-hud font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-slate-800 border border-white/40 text-white';
          cycleBtn.innerHTML = `<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="9"/></svg><span>Concluir</span>`;
          cycleBtn.style.backgroundColor = '#ffffff';
          cycleBtn.style.color = '#05080d';
        } else {
          badge.textContent = 'PLANEJADA';
          badge.className = 'text-[10px] font-hud font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-slate-400';
          cycleBtn.innerHTML = `<svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polygon points="5 3 19 12 5 21 5 3"/></svg><span>Iniciar</span>`;
          cycleBtn.style.backgroundColor = '#1e293b';
          cycleBtn.style.color = '#f8fafc';
        }
      }
    }

    function cycleSelectedNodeStatus() {
      const node = appData.nodes.find(n => n.id === selectedNodeId);
      if (!node || node.nodeType === 'category') return;

      const order = ['planned', 'in_progress', 'completed'];
      const nextStatus = order[(order.indexOf(node.status) + 1) % order.length];
      node.status = nextStatus;

      if (nextStatus === 'completed' && !node.completedDate) {
        const now = new Date();
        const yyyy = now.getFullYear();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const dd = String(now.getDate()).padStart(2, '0');
        node.completedDate = `${yyyy}-${mm}-${dd}`;
      }

      saveData();
      rebuildSceneDOM();
      updateMicroTopNav();
      updateNodeHudDrawer();
      showToast(
        nextStatus === 'completed'
          ? 'Habilidade concluída!'
          : nextStatus === 'in_progress'
          ? 'Marcada como em andamento'
          : 'Marcada como planejada'
      );
    }

    function toggleDeleteConfirm(show) {
      const bar = document.getElementById('delete-confirm-bar');
      if (!show) {
        bar.classList.add('hidden');
        return;
      }
      const node = appData.nodes.find(n => n.id === selectedNodeId);
      if (!node) return;

      const children = appData.nodes.filter(n => n.parentId === node.id);
      const textEl = document.getElementById('delete-confirm-text');
      const keepBtn = document.getElementById('btn-delete-keep-children');
      const allBtn = document.getElementById('btn-delete-all-branch');

      if (children.length > 0) {
        textEl.textContent = `Este item possui ${children.length} derivação(ões). Como deseja excluir?`;
        keepBtn.classList.remove('hidden');
        allBtn.textContent = 'Apagar Tudo';
      } else {
        textEl.textContent = `Excluir "${node.title}" permanentemente?`;
        keepBtn.classList.add('hidden');
        allBtn.textContent = 'Confirmar Exclusão';
      }
      bar.classList.remove('hidden');
    }

    function confirmDeleteSelectedNode(keepChildren) {
      const node = appData.nodes.find(n => n.id === selectedNodeId);
      if (!node) return;

      if (keepChildren) {
        appData.nodes.forEach((n) => {
          if (n.parentId === node.id) {
            n.parentId = node.parentId;
          }
        });
        appData.nodes = appData.nodes.filter(n => n.id !== node.id);
        showToast('Item removido e derivações reconectadas');
      } else {
        const descendants = getDescendantNodes(node.id).map(d => d.id);
        const toRemove = new Set([node.id, ...descendants]);
        appData.nodes = appData.nodes.filter(n => !toRemove.has(n.id));
        showToast('Item e derivações excluídos');
      }

      selectedNodeId = null;
      saveData();
      rebuildSceneDOM();
      updateMicroTopNav();
      updateNodeHudDrawer();

      if (currentView === 'micro' && activeSectionId) {
        const secNodes = appData.nodes.filter(n => n.sectionId === activeSectionId);
        document.getElementById('empty-section-hint').classList.toggle('hidden', secNodes.length > 0);
      }
    }

    // 11. MODAL DE SEÇÃO (CRIAR / EDITAR / EXCLUIR FATIA DO ANEL)
    function initColorSwatches() {
      const wrap = document.getElementById('sec-color-swatches');
      wrap.innerHTML = '';
      NEON_PALETTE.forEach((c) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'flex items-center gap-1.5 px-2 py-1.5 rounded-lg bg-[#05080d] border border-slate-800 hover:border-slate-500 text-left transition';
        btn.innerHTML = `<span class="w-3.5 h-3.5 rounded-full shrink-0" style="background:${c.hex}; box-shadow:0 0 8px ${c.hex}"></span><span class="text-[11px] font-hud text-slate-300 truncate">${c.name.split(' ')[0]}</span>`;
        btn.onclick = () => {
          document.getElementById('sec-input-color').value = c.hex;
        };
        wrap.appendChild(btn);
      });
    }

    function openSectionModal(isEdit) {
      editingSectionId = isEdit && activeSectionId ? activeSectionId : null;
      const modal = document.getElementById('section-modal');
      const titleEl = document.getElementById('section-modal-title');
      const nameInput = document.getElementById('sec-input-name');
      const colorInput = document.getElementById('sec-input-color');
      const deleteZone = document.getElementById('sec-delete-zone');
      document.getElementById('sec-del-confirm').classList.add('hidden');

      if (editingSectionId) {
        const sec = appData.sections.find(s => s.id === editingSectionId);
        if (!sec) return;
        titleEl.textContent = 'Editar Seção';
        nameInput.value = sec.name;
        colorInput.value = sec.color;
        deleteZone.classList.remove('hidden');
      } else {
        titleEl.textContent = 'Nova Seção';
        nameInput.value = '';
        const nextColor = NEON_PALETTE[appData.sections.length % NEON_PALETTE.length].hex;
        colorInput.value = nextColor;
        deleteZone.classList.add('hidden');
      }

      modal.classList.remove('hidden');
      setTimeout(() => nameInput.focus(), 60);
    }

    function closeSectionModal() {
      document.getElementById('section-modal').classList.add('hidden');
      editingSectionId = null;
    }

    function saveSectionModal() {
      const name = document.getElementById('sec-input-name').value.trim();
      const color = document.getElementById('sec-input-color').value || '#00e5ff';

      if (!name) {
        showToast('Digite um nome para a seção');
        return;
      }

      if (editingSectionId) {
        const sec = appData.sections.find(s => s.id === editingSectionId);
        if (sec) {
          sec.name = name;
          sec.color = color;
        }
        saveData();
        closeSectionModal();
        rebuildSceneDOM();
        updateMicroTopNav();
        showToast('Seção atualizada');
      } else {
        const newSec = {
          id: 'sec_' + Date.now(),
          name,
          color
        };
        appData.sections.push(newSec);
        saveData();
        closeSectionModal();
        refreshApp();
        showToast(`Seção "${name}" criada`);
      }
    }

    function deleteCurrentSection() {
      if (!editingSectionId) return;
      const targetId = editingSectionId;
      appData.sections = appData.sections.filter(s => s.id !== targetId);
      appData.nodes = appData.nodes.filter(n => n.sectionId !== targetId);
      saveData();
      closeSectionModal();
      selectedNodeId = null;
      activeSectionId = null;
      currentView = 'macro';
      camera.morphT = 0;
      camera.zoom = 1;
      camera.panX = 0;
      camera.panY = 0;
      camera.rotDeg = 0;
      refreshApp();
      showToast('Seção removida do anel');
    }

    // 12. MODAL DE NÓ (NOVO RAMO, DERIVAR DEPOIS, INSERIR ANTES, EDITAR)
    function initIconPicker() {
      const grid = document.getElementById('icon-picker-grid');
      grid.innerHTML = '';
      Object.keys(ICON_LIBRARY).forEach((key) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.iconKey = key;
        btn.className = 'icon-pick-btn h-9 rounded-lg border border-slate-800 bg-[#090d16] hover:border-slate-500 flex items-center justify-center text-slate-300 transition';
        btn.innerHTML = `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICON_LIBRARY[key]}</svg>`;
        btn.onclick = () => selectModalIcon(key);
        grid.appendChild(btn);
      });
    }

    function selectModalIcon(key) {
      selectedIconKey = key;
      document.querySelectorAll('.icon-pick-btn').forEach((btn) => {
        const active = btn.dataset.iconKey === key;
        btn.classList.toggle('border-cyan-400', active);
        btn.classList.toggle('bg-cyan-950/70', active);
        btn.classList.toggle('text-cyan-300', active);
      });
    }

    function setModalNodeType(type) {
      modalNodeType = type === 'category' ? 'category' : 'skill';
      const btnCat = document.getElementById('type-btn-category');
      const btnSkill = document.getElementById('type-btn-skill');
      const helper = document.getElementById('node-type-helper');
      const titleLabel = document.getElementById('node-title-label');
      const titleInput = document.getElementById('node-input-title');
      const skillFields = document.getElementById('skill-only-fields');

      if (modalNodeType === 'category') {
        btnCat.className = 'py-2 px-2.5 rounded-lg font-hud font-bold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-1.5 transition bg-cyan-500 text-slate-950 shadow';
        btnSkill.className = 'py-2 px-2.5 rounded-lg font-hud font-bold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-1.5 transition text-slate-400 hover:text-white';
        helper.textContent = 'Agrupador ou domínio (ex: Guitarra, Flauta, Gaita). Não possui XP nem status de conclusão.';
        titleLabel.textContent = 'Nome do Ramo / Subcategoria *';
        titleInput.placeholder = 'Ex: Guitarra, Flauta, Gaita...';
        skillFields.classList.add('hidden');
      } else {
        btnSkill.className = 'py-2 px-2.5 rounded-lg font-hud font-bold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-1.5 transition bg-white text-slate-950 shadow';
        btnCat.className = 'py-2 px-2.5 rounded-lg font-hud font-bold text-xs sm:text-sm uppercase tracking-wider flex items-center justify-center gap-1.5 transition text-slate-400 hover:text-white';
        helper.textContent = 'Marco ou habilidade rastreável com nível de dificuldade (XP), status e data opcional.';
        titleLabel.textContent = 'Nome da Habilidade / Conquista *';
        titleInput.placeholder = 'Ex: Bends, Vibratos, 5km Contínuos...';
        skillFields.classList.remove('hidden');
      }
    }

    function openNodeModal(mode) {
      if (!activeSectionId) return;
      nodeModalMode = mode;
      targetNodeId = selectedNodeId;

      const modal = document.getElementById('node-modal');
      const titleEl = document.getElementById('node-modal-title');
      const subEl = document.getElementById('node-modal-subtitle');
      const titleInput = document.getElementById('node-input-title');
      const diffInput = document.getElementById('node-input-diff');
      const statusInput = document.getElementById('node-input-status');
      const dateInput = document.getElementById('node-input-date');
      const descInput = document.getElementById('node-input-desc');

      const sec = appData.sections.find(s => s.id === activeSectionId);
      const targetNode = targetNodeId ? appData.nodes.find(n => n.id === targetNodeId) : null;

      if (mode === 'edit' && targetNode) {
        titleEl.textContent = 'Editar Nó';
        subEl.textContent = `SEÇÃO: ${sec ? sec.name : ''}`;
        setModalNodeType(targetNode.nodeType);
        titleInput.value = targetNode.title;
        diffInput.value = String(targetNode.difficulty || 3);
        statusInput.value = targetNode.status || 'planned';
        dateInput.value = targetNode.completedDate || '';
        descInput.value = targetNode.description || '';
        selectModalIcon(targetNode.icon || 'star');
      } else if (mode === 'derive' && targetNode) {
        titleEl.textContent = 'Derivar Depois';
        subEl.textContent = `DERIVANDO DE: ${targetNode.title}`;
        setModalNodeType('skill');
        titleInput.value = '';
        diffInput.value = '3';
        statusInput.value = 'planned';
        dateInput.value = '';
        descInput.value = '';
        selectModalIcon('star');
      } else if (mode === 'insert_before' && targetNode) {
        titleEl.textContent = 'Inserir Pré-Requisito Antes';
        subEl.textContent = `INSERINDO ANTES DE: ${targetNode.title}`;
        setModalNodeType(targetNode.parentId ? 'skill' : 'category');
        titleInput.value = '';
        diffInput.value = '2';
        statusInput.value = 'completed';
        dateInput.value = '';
        descInput.value = '';
        selectModalIcon('layers');
      } else {
        // create_root
        titleEl.textContent = 'Novo Ramo na Seção';
        subEl.textContent = `ARCO: ${sec ? sec.name : ''}`;
        setModalNodeType('category');
        titleInput.value = '';
        diffInput.value = '3';
        statusInput.value = 'planned';
        dateInput.value = '';
        descInput.value = '';
        selectModalIcon('music');
      }

      modal.classList.remove('hidden');
      setTimeout(() => titleInput.focus(), 60);
    }

    function closeNodeModal() {
      document.getElementById('node-modal').classList.add('hidden');
    }

    function saveNodeModal() {
      const title = document.getElementById('node-input-title').value.trim();
      if (!title) {
        showToast('Digite um nome para o nó');
        return;
      }

      const difficulty = parseInt(document.getElementById('node-input-diff').value, 10) || 3;
      const status = document.getElementById('node-input-status').value || 'planned';
      const completedDate = document.getElementById('node-input-date').value || '';
      const description = document.getElementById('node-input-desc').value.trim();

      if (nodeModalMode === 'edit' && targetNodeId) {
        const node = appData.nodes.find(n => n.id === targetNodeId);
        if (node) {
          node.nodeType = modalNodeType;
          node.title = title;
          node.icon = selectedIconKey;
          node.description = description;
          if (modalNodeType === 'skill') {
            node.difficulty = difficulty;
            node.status = status;
            node.completedDate = completedDate;
          }
        }
        saveData();
        closeNodeModal();
        rebuildSceneDOM();
        updateMicroTopNav();
        updateNodeHudDrawer();
        showToast('Nó atualizado');
        return;
      }

      const newId = 'node_' + Date.now() + '_' + Math.random().toString(36).slice(2, 5);
      let parentId = null;

      if (nodeModalMode === 'derive' && targetNodeId) {
        parentId = targetNodeId;
      } else if (nodeModalMode === 'insert_before' && targetNodeId) {
        const targetNode = appData.nodes.find(n => n.id === targetNodeId);
        if (targetNode) {
          parentId = targetNode.parentId;
          targetNode.parentId = newId;
        }
      }

      const newNode = normalizeNode({
        id: newId,
        sectionId: activeSectionId,
        parentId,
        nodeType: modalNodeType,
        title,
        icon: selectedIconKey,
        description,
        difficulty,
        status,
        completedDate
      });

      appData.nodes.push(newNode);
      selectedNodeId = newId;
      saveData();
      closeNodeModal();

      document.getElementById('empty-section-hint').classList.add('hidden');
      rebuildSceneDOM();
      updateMicroTopNav();
      updateNodeHudDrawer();
      showToast(
        nodeModalMode === 'insert_before'
          ? 'Pré-requisito inserido antes'
          : modalNodeType === 'category'
          ? 'Ramo criado'
          : 'Habilidade adicionada'
      );
    }

    // 13. MODAL DE DADOS, BACKUP JSON E RESET DO MOLDE
    function openDataModal() {
      document.getElementById('wipe-confirm-box').classList.add('hidden');
      renderModalSectionsList();
      document.getElementById('data-modal').classList.remove('hidden');
    }

    function closeDataModal() {
      document.getElementById('data-modal').classList.add('hidden');
    }

    function renderModalSectionsList() {
      const list = document.getElementById('modal-sections-list');
      list.innerHTML = '';
      if (appData.sections.length === 0) {
        list.innerHTML = '<p class="text-xs text-slate-500 italic py-2">Nenhuma seção criada ainda.</p>';
        return;
      }

      appData.sections.forEach((sec) => {
        const secNodes = appData.nodes.filter(n => n.sectionId === sec.id);
        const stats = getSkillStats(secNodes);
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between px-3 py-2 rounded-xl bg-[#05080d] border border-slate-800';
        item.innerHTML = `
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-3 h-3 rounded-full shrink-0" style="background:${sec.color}"></span>
            <span class="font-hud font-bold text-sm text-white truncate">${sec.name}</span>
          </div>
          <div class="flex items-center gap-2 shrink-0">
            <span class="text-[11px] font-mono text-slate-400">${stats.completedSkills}/${stats.totalSkills}</span>
            <button type="button" class="text-xs font-hud font-bold uppercase text-cyan-400 hover:text-cyan-300 px-1.5 py-0.5 rounded bg-slate-900">Abrir</button>
          </div>
        `;
        item.querySelector('button').onclick = () => {
          closeDataModal();
          switchToMicro(sec.id);
        };
        list.appendChild(item);
      });
    }

    function exportBackupJSON() {
      try {
        const payload = {
          app: 'ctOS Personal Skill Tree',
          exportedAt: new Date().toISOString(),
          sections: appData.sections,
          nodes: appData.nodes
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `ctos-skills-backup-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('Backup .json exportado');
      } catch (err) {
        showToast('Erro ao exportar backup');
      }
    }

    function importBackupJSON(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          if (!Array.isArray(parsed.sections) || !Array.isArray(parsed.nodes)) {
            showToast('Arquivo JSON inválido');
            return;
          }
          appData = {
            sections: parsed.sections,
            nodes: parsed.nodes.map(normalizeNode)
          };
          saveData();
          closeDataModal();
          selectedNodeId = null;
          activeSectionId = null;
          currentView = 'macro';
          camera.morphT = 0;
          camera.zoom = 1;
          camera.panX = 0;
          camera.panY = 0;
          camera.rotDeg = 0;
          refreshApp();
          showToast('Backup restaurado com sucesso!');
        } catch (err) {
          showToast('Erro ao ler arquivo JSON');
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

    function wipeToBlankMold() {
      appData = { sections: [], nodes: [] };
      saveData();
      closeDataModal();
      selectedNodeId = null;
      activeSectionId = null;
      currentView = 'macro';
      camera.morphT = 0;
      camera.zoom = 1;
      camera.panX = 0;
      camera.panY = 0;
      camera.rotDeg = 0;
      refreshApp();
      showToast('Molde limpo e pronto para uso');
    }

    function restoreDemoData() {
      appData = getDefaultDemoData();
      saveData();
      closeDataModal();
      selectedNodeId = null;
      activeSectionId = null;
      currentView = 'macro';
      camera.morphT = 0;
      camera.zoom = 1;
      camera.panX = 0;
      camera.panY = 0;
      camera.rotDeg = 0;
      refreshApp();
      showToast('Exemplo demonstrativo restaurado');
    }

    // 14. GESTOS DE TOQUE / MOUSE (ARRASTAR, PINCH-TO-ZOOM E ATALHOS)
    function clientToSvgDelta(dxPx, dyPx) {
      const svg = document.getElementById('skill-svg');
      const rect = svg.getBoundingClientRect();
      const minDim = Math.max(1, Math.min(rect.width, rect.height));
      const scale = 1000 / minDim;
      return {
        dx: dxPx * scale,
        dy: dyPx * scale
      };
    }

    function setupPointerEvents() {
      const container = document.getElementById('canvas-container');

      // Mouse events
      container.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        cameraAnim = null;
        isDragging = true;
        dragMoved = false;
        dragStart = { x: e.clientX, y: e.clientY };
        cameraStart = { x: camera.panX, y: camera.panY };
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const dxPx = e.clientX - dragStart.x;
        const dyPx = e.clientY - dragStart.y;
        if (Math.hypot(dxPx, dyPx) > 5) {
          dragMoved = true;
        }
        const delta = clientToSvgDelta(dxPx, dyPx);
        camera.panX = cameraStart.x + delta.dx;
        camera.panY = cameraStart.y + delta.dy;
        applySceneFrame();
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          setTimeout(() => {
            dragMoved = false;
          }, 40);
        }
      });

      // Wheel zoom
      container.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          const factor = e.deltaY < 0 ? 1.12 : 0.89;
          zoomBy(factor);
        },
        { passive: false }
      );

      // Touch events (1 dedo = arrastar, 2 dedos = pinch-to-zoom)
      container.addEventListener(
        'touchstart',
        (e) => {
          if (e.touches.length === 1) {
            cameraAnim = null;
            isDragging = true;
            dragMoved = false;
            dragStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
            cameraStart = { x: camera.panX, y: camera.panY };
          } else if (e.touches.length === 2) {
            cameraAnim = null;
            isDragging = false;
            initialPinchDist = Math.hypot(
              e.touches[0].clientX - e.touches[1].clientX,
              e.touches[0].clientY - e.touches[1].clientY
            );
            initialPinchScale = camera.zoom;
          }
        },
        { passive: true }
      );

      container.addEventListener(
        'touchmove',
        (e) => {
          if (e.touches.length === 1 && isDragging) {
            const dxPx = e.touches[0].clientX - dragStart.x;
            const dyPx = e.touches[0].clientY - dragStart.y;
            if (Math.hypot(dxPx, dyPx) > 6) {
              dragMoved = true;
            }
            const delta = clientToSvgDelta(dxPx, dyPx);
            camera.panX = cameraStart.x + delta.dx;
            camera.panY = cameraStart.y + delta.dy;
            applySceneFrame();
          } else if (e.touches.length === 2 && initialPinchDist) {
            const currDist = Math.hypot(
              e.touches[0].clientX - e.touches[1].clientX,
              e.touches[0].clientY - e.touches[1].clientY
            );
            const ratio = currDist / initialPinchDist;
            camera.zoom = Math.min(4.2, Math.max(0.45, initialPinchScale * ratio));
            applySceneFrame();
          }
        },
        { passive: true }
      );

      container.addEventListener('touchend', () => {
        isDragging = false;
        initialPinchDist = null;
        setTimeout(() => {
          dragMoved = false;
        }, 50);
      });

      // Toque no fundo vazio fecha o painel de detalhes do nó
      document.getElementById('skill-svg').addEventListener('click', () => {
        if (!dragMoved && selectedNodeId) {
          deselectNode();
        }
      });

      window.addEventListener('resize', () => {
        if (currentView === 'micro' && activeSectionId && !cameraAnim) {
          const framing = getCanonicalMicroFraming(activeSectionId);
          camera.zoom = framing.zoom;
          camera.panX = framing.panX;
          camera.panY = framing.panY;
        }
        applySceneFrame();
      });
    }

    function setupKeyboardShortcuts() {
      window.addEventListener('keydown', (e) => {
        const isInputFocused = ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName);
        if (isInputFocused) return;

        if (e.key === 'Escape') {
          if (!document.getElementById('node-modal').classList.contains('hidden')) {
            closeNodeModal();
          } else if (!document.getElementById('section-modal').classList.contains('hidden')) {
            closeSectionModal();
          } else if (!document.getElementById('data-modal').classList.contains('hidden')) {
            closeDataModal();
          } else if (selectedNodeId) {
            deselectNode();
          } else if (currentView === 'micro') {
            switchToMacro();
          }
        } else if (currentView === 'micro' && e.key === 'ArrowLeft') {
          navigateSection(-1);
        } else if (currentView === 'micro' && e.key === 'ArrowRight') {
          navigateSection(1);
        }
      });
    }

    // 15. SINCRONIZAÇÃO GERAL DO APLICATIVO
    function refreshApp() {
      const hasSections = appData.sections.length > 0;
      document.getElementById('empty-mold-overlay').classList.toggle('hidden', hasSections);

      if (currentView === 'macro') {
        document.getElementById('macro-brand').classList.remove('hidden');
        document.getElementById('btn-back-macro').classList.add('hidden');
        document.getElementById('btn-back-macro').classList.remove('flex');
        document.getElementById('micro-nav').classList.add('hidden');
        document.getElementById('btn-add-section').classList.remove('hidden');
        document.getElementById('btn-add-root-bottom').classList.add('hidden');
        document.getElementById('empty-section-hint').classList.add('hidden');
      }

      rebuildSceneDOM();
      updateNodeHudDrawer();
    }

    window.addEventListener('DOMContentLoaded', initApp);
  </script>
