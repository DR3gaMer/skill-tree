        status: statusMap[raw.status] || 'planned',
        difficulty: Math.min(5, Math.max(1, parseInt(raw.difficulty, 10) || 3)),
        completedDate: raw.completedDate || ''
      };
    }

    function loadData() {
      try {
        const rawV2 = localStorage.getItem(STORAGE_KEY);
        if (rawV2) {
          const parsed = JSON.parse(rawV2);
          if (Array.isArray(parsed.sections) && Array.isArray(parsed.nodes)) {
            appData = {
              sections: parsed.sections,
              nodes: parsed.nodes.map(normalizeNode)
            };
            return;
          }
        }
        const rawLegacy = localStorage.getItem(LEGACY_KEY);
        if (rawLegacy) {
          const parsedLegacy = JSON.parse(rawLegacy);
          if (Array.isArray(parsedLegacy.sections) && Array.isArray(parsedLegacy.nodes)) {
            appData = {
              sections: parsedLegacy.sections,
              nodes: parsedLegacy.nodes.map(normalizeNode)
            };
            saveData();
            return;
          }
        }
      } catch (err) {
        console.warn('Erro ao ler dados locais:', err);
      }
      appData = getDefaultDemoData();
      saveData();
    }

